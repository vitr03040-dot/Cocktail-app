<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Коктейли</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body { font-family: sans-serif; background: #fff; color: #000; padding: 20px; }
    .card { border: 1px solid #ccc; padding: 15px; margin: 10px 0; border-radius: 10px; text-align: center; }
    button { background: #3390ec; color: white; border: none; padding: 12px 24px; border-radius: 8px; font-size: 16px; }
  </style>
</head>
<body>
  <h1>🍸 Каталог коктейлей</h1>
  <div id="app">
    
    <!-- Коктейль 1: Апероль Шприц -->
    <div class="card">
      <h3>🍊 Апероль Шприц</h3>
      <p>⭐ 4.8</p>
      <p>Апероль, просекко, содовая</p>
      <button onclick="sendData(1)">Выбрать</button>
    </div>

    <!-- Коктейль 2: Мохито -->
    <div class="card">
      <h3>🌿 Мохито</h3>
      <p>⭐ 4.9</p>
      <p>Ром, мята, лайм, содовая</p>
      <button onclick="sendData(2)">Выбрать</button>
    </div>

    <!-- Коктейль 3: Маргарита -->
    <div class="card">
      <h3>🍋 Маргарита</h3>
      <p>⭐ 4.7</p>
      <p>Текила, ликёр, лайм, соль</p>
      <button onclick="sendData(3)">Выбрать</button>
    </div>

    <!-- Коктейль 4: Пина Колада -->
    <div class="card">
      <h3>🥥 Пина Колада</h3>
      <p>⭐ 4.6</p>
      <p>Ром, кокос, ананас</p>
      <button onclick="sendData(4)">Выбрать</button>
    </div>

  </div>

  <script>
    const tg = window.Telegram.WebApp;
    tg.expand();
    
    function sendData(id = 1) {
      tg.sendData(JSON.stringify({ action: 'choose', id: id }));
    }
  </script>
</body>
</html>
